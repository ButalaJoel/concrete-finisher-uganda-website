# Copy to server/.env for development. In production set these
# in your hosting dashboard (e.g. Render) instead of a file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=

# Long random string used to sign login tokens
JWT_SECRET=

# Cloudinary (project images, company logo, profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production only: the website addresses allowed to call the API,
# comma separated, no trailing slash
CORS_ORIGINS=https://www.concretefinisherug.com,https://concretefinisherug.com

# One-time first admin account (npm run provision:admin)
ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
